# ── Core ─────────────────────────────────────────────────────────────────────
PORT=5005
# MONGO_URI=mongodb://localhost:27017/theshine
JWT_SECRET=
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# ── Hardware integration (ANPR cameras + tunnel wash controller) ─────────────
# Site devices authenticate with a device id and a shared secret, not a JWT.
# One entry per edge connector. Generate with: openssl rand -hex 32
INTEGRATION_DEVICE_KEYS={"edge-connector-1":"replace-with-a-long-random-secret"}

# Rejects replayed requests outside this window (milliseconds).
INTEGRATION_MAX_SKEW_MS=300000
INTEGRATION_MAX_BATCH=200

# Timezone the daily and monthly membership caps reset on.
SITE_TIMEZONE=Asia/Kolkata

# A car re-seen on the entry loop inside this window is the same arrival,
# not a second visit.
INTEGRATION_ENTRY_DEBOUNCE_MS=600000
# How far back to look for the booking a driver made earlier today.
INTEGRATION_BOOKING_WINDOW_MS=43200000
# A tunnel cycle that never reported completion is abandoned after this long.
INTEGRATION_SESSION_STALE_MS=7200000

# ── Scheduled staff breaks ───────────────────────────────────────────────────
# Break start times are read in SITE_TIMEZONE (above).
# The in-process scheduler ticks every 30s under PM2 / `npm start`. It is
# skipped automatically on Vercel; set false to disable it anywhere else.
BREAK_SCHEDULER_ENABLED=true
# How many minutes late a scheduled break may still fire (e.g. after a restart).
BREAK_CATCHUP_MIN=10
# A scheduled break the staff never started is logged as missed after this.
BREAK_PENDING_EXPIRY_MIN=60
# An active break is force-closed this many minutes past its end (overtime kept).
BREAK_MAX_OVERTIME_MIN=240
# true = only fire breaks for staff with an open attendance check-in today.
BREAK_REQUIRE_CHECKIN=false
# Serverless only: an external per-minute pinger calls
#   POST /api/internal/break-scheduler/tick   with header  x-cron-secret: <value>
# Leave empty to keep that endpoint disabled (404). Generate: openssl rand -hex 32
BREAK_CRON_SECRET=

# ── WhatsApp Hub (Meta WhatsApp Cloud API) ───────────────────────────────────
# Without PHONE_NUMBER_ID + ACCESS_TOKEN the admin WhatsApp Hub runs in manual
# mode (opens each chat via wa.me). Get these from developers.facebook.com ->
# your app -> WhatsApp -> API Setup. Use a permanent System User token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# App ID is needed only to submit templates with an image/video/document header.
WHATSAPP_APP_ID=
# App secret verifies webhook signatures (App settings -> Basic).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Any random string; paste the same value into Meta's webhook "Verify token".
# Callback URL: https://<your-backend>/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Recipients sent per sender tick (every 15s under PM2).
WHATSAPP_SEND_BATCH=50
# true = only contacts explicitly marked opted-in receive campaigns.
WHATSAPP_REQUIRE_OPT_IN=false
# true = run the full pipeline without calling Meta (fake message ids) for testing.
WHATSAPP_DRY_RUN=false
# Serverless only: POST /api/internal/whatsapp/tick with header x-cron-secret.
# Falls back to BREAK_CRON_SECRET when empty.
WHATSAPP_CRON_SECRET=
# BhashSMS scripts per category (Utility templates use sendmsgutil.php).
BHASHSMS_UTILITY_SCRIPT=sendmsgutil.php
BHASHSMS_MARKETING_SCRIPT=sendmsg.php
BHASHSMS_TEXT_SCRIPT=sendmsg.php
