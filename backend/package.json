{
  "name": "multi-service-backend",
  "version": "1.0.0",
  "description": "Backend for Multi-Service Booking Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-timeout=120000 \"tests/**/*.test.js\"",
    "test:unit": "node --test tests/plateNormalizer.test.js tests/membershipEntitlement.test.js tests/washStateMachine.test.js tests/parkingAnprAdapter.test.js tests/tunnelWashAdapter.test.js tests/integrationsMiddleware.test.js",
    "seed": "node src/utils/seed.js",
    "backfill:plates": "node src/utils/backfillPlateNormalization.js",
    "demo:seed": "node src/utils/seedIntegrationDemo.js",
    "demo:clean": "node src/utils/seedIntegrationDemo.js --clean"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0"
  }
}
