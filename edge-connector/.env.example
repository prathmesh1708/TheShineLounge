# ── Cloud ────────────────────────────────────────────────────────────────────
TSL_CLOUD_URL=https://api.theshinelounge.example
TSL_DEVICE_ID=edge-connector-1
# Must match an entry in the backend's INTEGRATION_DEVICE_KEYS.
TSL_DEVICE_SECRET=

# ── ANPR / parking system (vendor interface document) ────────────────────────
ANPR_ENABLED=true
ANPR_BASE_URL=http://192.168.1.169:9001
# MAC:role[:laneId] — roles: entry, exit, tunnel-entry, tunnel-exit
ANPR_CHANNELS=1803001B1226:entry:lane-1,1803001B1227:exit:lane-1
ANPR_POLL_INTERVAL_MS=1000
ANPR_RECONCILE_INTERVAL_MS=300000
ANPR_PHOTO_BASE_URL=http://192.168.1.169:9001

# ── Tunnel wash controller (pending the distributor's spec) ──────────────────
TUNNEL_ENABLED=false
# json | dry-contact | counter
TUNNEL_MODE=json
TUNNEL_WEBHOOK_PORT=9101
TUNNEL_WEBHOOK_PATH=/tunnel/events
TUNNEL_WEBHOOK_TOKEN=
TUNNEL_POLL_URL=
TUNNEL_LANE_ID=tunnel-1
TUNNEL_CONTACT_CHANNELS=1:wash.started,2:wash.completed

# ── Local queue ──────────────────────────────────────────────────────────────
TSL_QUEUE_DIR=./queue
TSL_FLUSH_INTERVAL_MS=2000
TSL_BATCH_SIZE=50
TSL_LOG_LEVEL=info
